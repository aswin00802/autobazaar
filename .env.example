# AutoBazaar — copy this file to .env and fill in the blanks.
#
#   cp .env.example .env
#   php artisan key:generate
#
# Never commit .env. It is in .gitignore for a reason.

APP_NAME=AutoBazaar
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# The address the site is served at, with no trailing slash.
#   XAMPP in a folder : http://localhost/autobazaar/public
#   php artisan serve : http://localhost:8000
#   another device    : http://<this machine's IP>:8000
APP_URL=http://localhost/autobazaar/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Create this database first — it can be empty, migrations build it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autobazaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 'log' writes mail to storage/logs instead of sending it — right for development.
# Real SMTP settings are entered in the admin panel under Settings, SMTP.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Outside services. The site runs without these, but the features that need
# them do not.
# ---------------------------------------------------------------------------

# SMS gateway (ping4sms). WITHOUT THIS NO OTP CAN BE SENT, so nobody can sign
# in to the website or either mobile app. Ask the project owner for the key.
PING4SMS_KEY=
PING4SMS_URL=http://site.ping4sms.com/api/smsapi

# Razorpay. These are only a fallback — the live keys are entered in the admin
# panel under Settings, Payments, and stored encrypted.
RAZORPAY_KEY=
RAZORPAY_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
