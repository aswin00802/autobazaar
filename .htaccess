# The application is served from /public. Everything else in the project
# root (.env, .git, storage, vendor, docs...) must never be reachable over HTTP.
# On a real host, point the domain's DocumentRoot at /public instead and this
# file is never consulted.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/) - [F,L]
</IfModule>
